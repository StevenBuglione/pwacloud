{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pwacloud:schema:verification-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pwacloud.verification.v1"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "archiveSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publisherIdentity": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "revocationSequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "format",
    "keyId",
    "pluginId",
    "version",
    "archiveSha256",
    "manifestSha256",
    "publisherIdentity",
    "policyVersion",
    "verifiedAt",
    "expiresAt",
    "revocationSequence"
  ]
}
