{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pwacloud:schema:plugin-manifest:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "pwacloud.dev/v0.1"
    },
    "kind": {
      "const": "Plugin"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9-]+){2,}$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "directory": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200
        }
      },
      "required": [
        "repository",
        "directory"
      ]
    },
    "hostApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major": {
          "const": 1
        },
        "minimumMinor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minimumMinor"
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "isolated-web",
            "host-rendered"
          ]
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200
        },
        "style": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200
        },
        "minWidthCssPx": {
          "type": "integer",
          "minimum": 320,
          "maximum": 360
        },
        "contributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "library-entry",
                  "route",
                  "command",
                  "settings",
                  "preview"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "type",
              "id",
              "title"
            ]
          }
        }
      },
      "required": [
        "profile",
        "entry",
        "minWidthCssPx",
        "contributes"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200
        },
        "world": {
          "const": "pwacloud:plugin/guest@0.1.0"
        },
        "maxLinearMemoryMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "entry",
        "world",
        "maxLinearMemoryMiB"
      ]
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,63}$"
              },
              "capability": {
                "const": "storage.kv"
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "quotaBytes": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 536870912
                  }
                },
                "required": [
                  "quotaBytes"
                ]
              }
            },
            "required": [
              "id",
              "capability",
              "required",
              "scope"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,63}$"
              },
              "capability": {
                "const": "network.http"
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rules": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "origin": {
                          "type": "string",
                          "pattern": "^https://[a-z0-9-]+(?:\\.[a-z0-9-]+)+(?::[0-9]{1,5})?$",
                          "maxLength": 253
                        },
                        "methods": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "GET",
                              "HEAD",
                              "POST",
                              "PUT",
                              "PATCH",
                              "DELETE"
                            ]
                          }
                        },
                        "pathPrefixes": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "pattern": "^/",
                            "maxLength": 200
                          }
                        }
                      },
                      "required": [
                        "origin",
                        "methods",
                        "pathPrefixes"
                      ]
                    }
                  }
                },
                "required": [
                  "rules"
                ]
              }
            },
            "required": [
              "id",
              "capability",
              "required",
              "scope"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,63}$"
              },
              "capability": {
                "const": "ai.respond"
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "context": {
                    "const": "selected-resources"
                  },
                  "requestsPerHour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "concurrency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "background": {
                    "const": false
                  }
                },
                "required": [
                  "context",
                  "requestsPerHour",
                  "concurrency",
                  "background"
                ]
              }
            },
            "required": [
              "id",
              "capability",
              "required",
              "scope"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,63}$"
              },
              "capability": {
                "const": "services.invoke"
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "interfaces": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "interfaces"
                ]
              }
            },
            "required": [
              "id",
              "capability",
              "required",
              "scope"
            ]
          }
        ]
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "name",
    "description",
    "version",
    "license",
    "source",
    "hostApi",
    "permissions",
    "provides",
    "requires"
  ],
  "anyOf": [
    {
      "required": [
        "ui"
      ]
    },
    {
      "required": [
        "service"
      ]
    }
  ]
}
