{
  "openapi": "3.1.0",
  "info": {
    "title": "PWACloud personal runtime",
    "version": "0.1.0",
    "description": "Target API contract. Not a running service. OAuth endpoints must be implemented from verified provider flow, not invented generic token sharing."
  },
  "servers": [
    {
      "url": "https://your-user-controlled-host.example"
    }
  ],
  "security": [
    {
      "appSession": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Process health only; not evidence of provider eligibility"
          }
        }
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "session",
        "description": "Return minimal session identity and capability modes; never tokens or undocumented plan claims.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "signOut",
        "description": "Revoke application session, streams and grants according to scope.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/provider/status": {
      "get": {
        "operationId": "providerStatus",
        "description": "Report disconnected, connecting, identity-only, eligible, limited, expired or blocked. A connected identity is not AI eligibility.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/provider/models": {
      "get": {
        "operationId": "models",
        "description": "Query authorized provider catalog and expose allowed visible models; cache per registration and workspace, not globally.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "slug": {
                        "type": "string",
                        "minLength": 1
                      },
                      "displayName": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "slug",
                      "displayName"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installs/resolve": {
      "post": {
        "operationId": "resolveInstall",
        "description": "Resolve supported public GitHub repository release to immutable manifest/envelope; no source build on phone.",
        "security": [
          {
            "appSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "repository",
                  "version"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "startRun",
        "description": "Bind actual session and selected installation/generation server-side; admit once and journal before dispatch. Never trust body as identity.",
        "security": [
          {
            "appSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "installId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 262144
                  },
                  "selectedDocumentHandles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 16
                  }
                },
                "required": [
                  "installId",
                  "generation",
                  "idempotencyKey",
                  "model",
                  "input",
                  "selectedDocumentHandles"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "runId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "reserved",
                        "running",
                        "completed",
                        "failed",
                        "interrupted",
                        "cancelled"
                      ]
                    },
                    "providerMode": {
                      "enum": [
                        "mock",
                        "chatgpt-plan-local",
                        "approved-hosted"
                      ]
                    },
                    "lastSequence": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "runId",
                    "state",
                    "providerMode",
                    "lastSequence"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}": {
      "parameters": [
        {
          "name": "runId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "readRun",
        "description": "Verify run belongs to session and installation before returning status.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "runId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "reserved",
                        "running",
                        "completed",
                        "failed",
                        "interrupted",
                        "cancelled"
                      ]
                    },
                    "providerMode": {
                      "enum": [
                        "mock",
                        "chatgpt-plan-local",
                        "approved-hosted"
                      ]
                    },
                    "lastSequence": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "runId",
                    "state",
                    "providerMode",
                    "lastSequence"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelRun",
        "description": "Request cancellation, revoke tool continuations and mark terminal state honestly; cancellation is not guaranteed refund.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "runId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "reserved",
                        "running",
                        "completed",
                        "failed",
                        "interrupted",
                        "cancelled"
                      ]
                    },
                    "providerMode": {
                      "enum": [
                        "mock",
                        "chatgpt-plan-local",
                        "approved-hosted"
                      ]
                    },
                    "lastSequence": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "runId",
                    "state",
                    "providerMode",
                    "lastSequence"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}/events": {
      "parameters": [
        {
          "name": "runId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "streamRun",
        "description": "Same-origin authenticated stream. Replay durable journal using Last-Event-ID. Disconnect never submits another AI request.",
        "security": [
          {
            "appSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "SSE with monotonic id and JSON data; terminal state explicit",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong run owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ]
      }
    },
    "/v1/network/request": {
      "post": {
        "operationId": "networkRequest",
        "description": "Scoped broker only: authenticate origin/session, resolve grant, verify DNS and actual peer, deny redirects by default and bound response.",
        "security": [
          {
            "appSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "installId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "grantId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "enum": [
                      "GET",
                      "HEAD",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  }
                },
                "required": [
                  "installId",
                  "generation",
                  "grantId",
                  "url",
                  "method"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid application session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, revoked, stale or unapproved capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "appSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-pwacloud-session",
        "description": "HttpOnly Secure Path=/; SameSite plus exact Origin/CSRF checks on state-changing requests. Phone gets this app session, never provider token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      }
    }
  }
}
