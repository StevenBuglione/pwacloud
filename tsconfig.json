{
  "compilerOptions": {
    "target":"ES2022", "module":"ESNext", "moduleResolution":"Bundler", "lib":["ES2023","DOM","DOM.Iterable"],
    "strict":true, "noEmit":true, "allowImportingTsExtensions":true, "resolveJsonModule":true,
    "jsx":"react-jsx", "noUncheckedIndexedAccess":true, "skipLibCheck":true, "types":["node"],
    "noUnusedLocals":true, "noUnusedParameters":true
  },
  "include":["apps/**/*.ts","apps/**/*.tsx","packages/**/*.ts","packages/**/*.tsx","scripts/**/*.ts","tests/**/*.ts","examples/**/*.ts","examples/**/*.tsx","src/**/*.ts","playwright.config.ts"],
  "exclude":["**/dist/**","**/target/**","**/generated/**"]
}
